{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start Backend Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/server.js",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
